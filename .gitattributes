# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf
*.pxi text eol=lf

# Shell scripts
*.sh text eol=lf

# R
*.R text eol=lf
*.r text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.ini text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.pkl binary
*.joblib binary
*.parquet binary
*.csv binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
